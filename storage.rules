rules_version = '2';

// Rasmlar: elektrik faqat o'z papkasiga (electricians/{uid}/...) yuklaydi, 1.5 MB gacha, faqat rasm.
// Sayt rasmlarni yuklashdan oldin brauzerda siqadi (WebP, ~1280px), shuning uchun bu chegara yetarli.
service firebase.storage {
  match /b/{bucket}/o {
    match /electricians/{uid}/{file} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 1.5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Admin tasdiqlash uchun sertifikat/hujjat rasmlari — faqat egasi yuklaydi, ommaga ko'rinmaydi
    match /verification/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 1.5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null
        && (request.auth.uid == uid || firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)));
    }
  }
}
